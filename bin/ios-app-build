#!/usr/bin/env bash
# iOS compile check — app + SPM interfaces against the simulator SDK.
# No simulator boot; compile feedback only. Zero warnings is the bar.
set -euo pipefail
cd "$(dirname "$0")/../apps/ios"

# Always (re)generate with the cache: a checked-out project that predates a file rename
# or delete fails with "Build input files cannot be found" (2026-09-23), and the cache makes
# an unchanged spec + file tree a no-op, so incremental builds stay incremental.
xcodegen generate --use-cache >/dev/null

# Wall-clock budget (restructure Phase 0.7): agents are timeblind, so the script says how
# long it took and fails past the budget. Measured 2026-09-23: 7 s incremental, ~60 s cold
# on this Mac; the default leaves room for a cold build, CI sets its own. Exceeding it is a
# defect to diagnose, never a reason to raise the number.
APP_BUILD_MAX_MS="${APP_BUILD_MAX_MS:-180000}"
start_ns="$(python3 -c 'import time; print(time.monotonic_ns())')"

OUTPUT=$(xcodebuild \
  -project VoCal.xcodeproj \
  -scheme VoCal \
  -destination 'generic/platform=iOS Simulator' \
  -derivedDataPath ../../DerivedData/ios-sim \
  build 2>&1) || { echo "$OUTPUT" | grep -E "error:" | head -30; echo "✗ BUILD FAILED"; exit 1; }

# appintentsmetadataprocessor chatter is tool noise, not a compiler warning.
WARNINGS=$(echo "$OUTPUT" | grep -E "warning:" | grep -v "appintentsmetadataprocessor" || true)
if [ -n "$WARNINGS" ]; then
  echo "$WARNINGS"
  echo "✗ build succeeded with warnings (the bar is zero)"
  exit 1
fi
elapsed_ms="$(python3 -c "import time,sys; print((time.monotonic_ns() - int(sys.argv[1])) // 1_000_000)" "$start_ns")"
echo "APP_BUILD_ELAPSED_MS=$elapsed_ms"
if (( elapsed_ms > APP_BUILD_MAX_MS )); then
  echo "✗ app-build timing budget exceeded: ${elapsed_ms}ms > ${APP_BUILD_MAX_MS}ms (diagnose, do not raise)" >&2
  exit 97
fi
echo "✓ ios-app-build green (zero warnings)"
