#!/usr/bin/env swift
// Pixel diff for the UI loop (docs/UI_VERIFICATION.md): where two PNGs differ, how much,
// and a difference image. No Python imaging stack needed on the Mac.
//
//   bin/png-diff actual.png golden.png [difference.png]
//
// Prints the fraction of differing pixels, the bounding box of the difference in points
// (assuming 3x), and writes the difference image (differing pixels in red on white) when a
// third path is given. Exit 0 when identical, 1 when they differ, 2 on a bad input.
import CoreGraphics
import Foundation
import ImageIO
import UniformTypeIdentifiers

func load(_ path: String) -> (CGImage, [UInt8])? {
    guard let source = CGImageSourceCreateWithURL(URL(fileURLWithPath: path) as CFURL, nil),
          let image = CGImageSourceCreateImageAtIndex(source, 0, nil) else { return nil }
    let width = image.width, height = image.height
    var bytes = [UInt8](repeating: 0, count: width * height * 4)
    let space = CGColorSpaceCreateDeviceRGB()
    guard let context = CGContext(data: &bytes, width: width, height: height, bitsPerComponent: 8, bytesPerRow: width * 4, space: space, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { return nil }
    context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
    return (image, bytes)
}

let args = CommandLine.arguments
guard args.count >= 3, let a = load(args[1]), let b = load(args[2]) else {
    FileHandle.standardError.write("usage: bin/png-diff actual.png golden.png [difference.png]\n".data(using: .utf8)!)
    exit(2)
}
let scale = 3.0
// Per-channel levels (0-255) a pixel may move before it counts; 8 ignores anti-aliasing
// jitter, 0 demands identity. PNG_DIFF_THRESHOLD=0 bin/png-diff a.png b.png
let threshold = Int(ProcessInfo.processInfo.environment["PNG_DIFF_THRESHOLD"] ?? "8") ?? 8
guard a.0.width == b.0.width, a.0.height == b.0.height else {
    print("size differs: \(a.0.width)x\(a.0.height) vs \(b.0.width)x\(b.0.height)")
    exit(1)
}
let width = a.0.width, height = a.0.height
var differing = 0
var minX = width, minY = height, maxX = -1, maxY = -1
var diff = [UInt8](repeating: 255, count: width * height * 4)
var histogram = [Int](repeating: 0, count: 256)  // pixels by their largest channel delta
for y in 0..<height {
    for x in 0..<width {
        let i = (y * width + x) * 4
        let delta = (0..<3).map { abs(Int(a.1[i + $0]) - Int(b.1[i + $0])) }.max()!
        histogram[delta] += 1
        if delta > threshold {
            differing += 1
            minX = min(minX, x); maxX = max(maxX, x); minY = min(minY, y); maxY = max(maxY, y)
            diff[i] = 220; diff[i + 1] = 40; diff[i + 2] = 40
        }
    }
}
let fraction = Double(differing) / Double(width * height)
let moved = histogram.enumerated().dropFirst().filter { $0.element > 0 }
let maxDelta = moved.last?.offset ?? 0
let movedCount = moved.reduce(0) { $0 + $1.element }
if differing == 0 {
    print("identical within \(threshold) levels (\(width)x\(height)); \(movedCount) pixels moved at most \(maxDelta) levels")
    exit(0)
}
print(String(format: "differ: %.3f%% of pixels (%d), box x %.0f-%.0f pt, y %.0f-%.0f pt of %dx%d pt", fraction * 100, differing, Double(minX) / scale, Double(maxX) / scale, Double(minY) / scale, Double(maxY) / scale, Int(Double(width) / scale), Int(Double(height) / scale)))
if args.count >= 4 {
    let space = CGColorSpaceCreateDeviceRGB()
    if let context = CGContext(data: &diff, width: width, height: height, bitsPerComponent: 8, bytesPerRow: width * 4, space: space, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue),
       let image = context.makeImage(),
       let destination = CGImageDestinationCreateWithURL(URL(fileURLWithPath: args[3]) as CFURL, UTType.png.identifier as CFString, 1, nil) {
        CGImageDestinationAddImage(destination, image, nil)
        CGImageDestinationFinalize(destination)
        print("difference image: \(args[3])")
    }
}
exit(1)
