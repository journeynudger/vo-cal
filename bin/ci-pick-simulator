#!/usr/bin/env python3
"""Pick the simulator a CI runner should use and print it as GitHub Actions env lines.

The scripts pin a simulator by UDID; on a runner the pin is whichever iPhone carries the
newest iOS runtime (a Pro model when there is one). Usage in a workflow step:

    bin/ci-pick-simulator >> "$GITHUB_ENV"
"""

import json
import re
import subprocess

listing = json.loads(
    subprocess.check_output(["xcrun", "simctl", "list", "devices", "available", "-j"])
)
best = None
for runtime, devices in listing["devices"].items():
    match = re.search(r"iOS-(\d+)-(\d+)", runtime)
    if not match:
        continue
    version = (int(match.group(1)), int(match.group(2)))
    for device in devices:
        if not device.get("isAvailable", True) or "iPhone" not in device["name"]:
            continue
        key = (version, "Pro" in device["name"], device["name"])
        if best is None or key > best[0]:
            best = (key, device)
if best is None:
    raise SystemExit("no iPhone simulator on this runner")
print(f"IOS_SIM_UDID={best[1]['udid']}")
print(f"IOS_SIM_NAME={best[1]['name']}")
