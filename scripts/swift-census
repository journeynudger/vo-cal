#!/usr/bin/env python3
"""Swift dead-code census: declarations nothing references outside their own line.

A heuristic, not a gate: it counts whole-word references across every tracked Swift file
(comments and doc comments stripped) and lists declarations whose count equals their
declaration count. Enum cases decoded from persisted data, delegate methods, SwiftUI
entry points and Codable fields show up here and are NOT dead; read each hit in context
before deleting (docs/restructure/02-map.md, "Delete with a census"). Found 2026-09-23:
twenty unreachable outbox methods, five test hooks with no test, and a dozen smaller
leftovers of the Serein port.

    scripts/swift-census            # everything
    scripts/swift-census apps/ios   # one root
"""
import re, subprocess, collections, sys
roots = sys.argv[1:] or ["."]
files = [f for f in subprocess.run(["git","ls-files","-z","--",*[r + "/*.swift" if r != "." else "*.swift" for r in roots]],capture_output=True,text=True).stdout.split("\0") if f]
src = {f: open(f, encoding="utf-8", errors="ignore").read() for f in files}
def strip(s):
    s = re.sub(r"/\*.*?\*/", "", s, flags=re.S)
    s = re.sub(r"//[^\n]*", "", s)
    return s
code = {f: strip(s) for f, s in src.items()}
decl_re = re.compile(r"^[ \t]*(?:@\w+(?:\([^)]*\))?[ \t]+)*(?:(?:public|internal|private|fileprivate|open|static|final|nonisolated|override|mutating|indirect|convenience|required|lazy|weak|unowned)[ \t]+)*(func|struct|class|enum|protocol|actor|typealias|let|var|case)[ \t]+([A-Za-z_][A-Za-z0-9_]*)", re.M)
decls = collections.defaultdict(list)
for f, s in code.items():
    for m in decl_re.finditer(s):
        decls[m.group(2)].append((f, m.group(1)))
skip = {"body","init","main","description","hash","encode","decode","makeCoordinator","updateUIGestureRecognizer","makeUIGestureRecognizer","handleUIGestureRecognizerAction","gestureRecognizerShouldBegin","gestureRecognizer","didReceive","wrappedValue","projectedValue","deinit","allCases","rawValue","errorDescription","debugDescription","localizedDescription"}
allcode = "\n".join(code.values())
out = []
for name, ds in decls.items():
    if name in skip or len(name) < 3: continue
    n = len(re.findall(r"(?<![\w.])"+re.escape(name)+r"\b", allcode)) + len(re.findall(r"\."+re.escape(name)+r"\b", allcode))
    if n <= len(ds):
        out.append((ds[0][0], ds[0][1], name, len(ds)))
out.sort()
print(f"decls={sum(len(v) for v in decls.values())} names={len(decls)} candidates={len(out)}", file=sys.stderr)
for f, kind, name, k in out:
    print(f"{f}: {kind} {name}" + (f" (x{k})" if k > 1 else ""))
